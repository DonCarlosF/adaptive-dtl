# Copy to .env and fill in. Never commit the real values.

# Required: a long random string used to sign auth tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the /api/ai/messages proxy. Without it, AI generation
# returns 503 and the client falls back to hand-authored activities.
ANTHROPIC_API_KEY=

# Optional: storage backend — "json" (default) or "sqlite".
DATA_BACKEND=json

# Optional: where the JSON data file lives (default ./data/db.json).
# Used when DATA_BACKEND=json.
DATA_FILE=./data/db.json

# Optional: where the SQLite database lives (default ./data/app.db).
# Used when DATA_BACKEND=sqlite. Runs in WAL mode (expect .db-wal/.db-shm
# sidecar files next to it).
DB_FILE=./data/app.db

# Optional: Express "trust proxy" setting. Leave unset when clients connect
# directly. Behind a TLS-terminating reverse proxy / load balancer set it
# ("true", a hop count like "1", or a preset like "loopback") so per-IP rate
# limiting and HSTS see the real client instead of the proxy.
# TRUST_PROXY=1

# Optional: port (default 8787).
PORT=8787
