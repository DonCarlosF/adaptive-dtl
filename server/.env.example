# Copy to .env and fill in. Never commit the real values.

# Required: a long random string used to sign auth tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the /api/ai/messages proxy. Without it, AI generation
# returns 503 and the client falls back to hand-authored activities.
ANTHROPIC_API_KEY=

# Optional: where the JSON data file lives (default ./data/db.json).
DATA_FILE=./data/db.json

# Optional: port (default 8787).
PORT=8787
